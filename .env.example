# Copy this file to .env and adjust values before running Docker Compose.
SLOPE_URL=https://da.y8.com/games/slope
SLOPE_MODEL_NAME=slope_qrdqn
SLOPE_STEPS=500000
SLOPE_FPS=12
SLOPE_CAPTURE_WIDTH=480
SLOPE_DEVICE=cpu
SLOPE_TORCH_THREADS=1
SLOPE_REPORT_EVERY=100
SLOPE_SAVE_EVERY=50000
SLOPE_EVAL_EVERY=50000
SLOPE_EVAL_EPISODES=10

# CPU-only PyTorch wheel installed into the default image.
TORCH_VERSION=2.8.0
